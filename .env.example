# Workbook
INPUT_XLSX=RFP Scrape Trial.xlsx

# Browser fallback
USE_PLAYWRIGHT_FALLBACK=true
REQUEST_TIMEOUT=25
DELAY_SECONDS=1.0
MAX_TEXT_CHARS=1500000
USER_AGENT=PharmaRFPMonitor/1.0 (polite public-page monitoring)

# Optional Google Sheets mirror for output/rfp_grant_matches.csv
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Sheet1
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service-account.json

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
# Separate multiple recipients with commas or semicolons.
ALERT_TO=prudhvi.vijayarao@emedevents.com,prudhvivijayarao@gmail.com

# Optional OCR for scanned PDFs:
# Install Tesseract OCR separately, then install:
# pip install pytesseract pillow
